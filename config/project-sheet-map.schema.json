{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["defaults", "projects"],
  "properties": {
    "defaults": {
      "type": "object",
      "required": ["masterSheet", "historySheet", "todoSheet"]
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["municipality", "name", "spreadsheetIdEnv"]
      }
    }
  }
}

